# HikeAI - Root gitignore
# Generated: 2025-11-02

# ============================================
# Dependencies
# ============================================
node_modules/
*/node_modules/
**/node_modules/

# ============================================
# Testing & Coverage
# ============================================
coverage/
*/coverage/
**/coverage/
test-results/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.*.local
.env.test
*.env

# Exception: Keep example env files
!.env.example
!*.env.example

# ============================================
# Build Outputs
# ============================================
dist/
build/
*.tsbuildinfo

# ============================================
# IDE & Editors
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# OS
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
.cache/
.temp/

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ============================================
# BMAD Specific
# ============================================
bmad/node_modules/
bmad/coverage/
bmad/dist/
bmad/*.log

# ============================================
# Backend Specific
# ============================================
backend/node_modules/
backend/coverage/
backend/dist/
backend/*.log

# ============================================
# Mobile Specific
# ============================================
mobile/node_modules/
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/*.log

# ============================================
# Documentation (temporary/generated)
# ============================================
# Keep all docs/ - these are important!
# Only ignore specific temp files
docs/**/*.tmp
docs/**/*.temp
