# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Rate Limiting
# Max requests per IP per 15 minutes (all endpoints)
RATE_LIMIT_MAX=100

# Max route generation requests per IP per 15 minutes
RATE_LIMIT_ROUTES=20

# OpenAI API (GPT-5-nano)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# Supabase Database
# Get credentials at: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY_HERE

# Mapy.cz API (optional for MVP)
MAPY_CZ_API_KEY=

# Google Places API (optional - for smart parking suggestions)
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable Places API: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=
