# Hike AI Mobile - Environment Configuration

# Backend API URL
# Development: Use your local IP address (find with `ipconfig` on Windows or `ifconfig` on Mac/Linux)
# Production: Use your deployed backend URL
# Format: http://YOUR_IP:PORT/api/v1 or https://your-domain.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Example for local development with specific IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1

# Example for production:
# EXPO_PUBLIC_API_URL=https://api.hikeai.app/api/v1

# IMPORTANT NOTES:
# 1. Copy this file to `.env` and update with your values
# 2. Do NOT commit `.env` to git (already in .gitignore)
# 3. Restart Expo development server after changing .env
# 4. On iOS/Android, you may need to restart the app after .env changes
