# HikeAI Continuous Testing Configuration

# Backend URL (where the HikeAI backend is running)
BACKEND_URL=http://localhost:3000

# Slack webhook for critical alerts (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email alerts (optional)
# EMAIL_ALERTS=your-email@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# OpenAI API Key (for testing external API dependencies)
# OPENAI_API_KEY=sk-...

# Metrics retention (days)
METRICS_RETENTION_DAYS=30

# Dashboard port
DASHBOARD_PORT=8080
